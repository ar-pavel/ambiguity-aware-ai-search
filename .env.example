# Copy this file to .env and fill in your own values. .env is ignored by git; never commit a key.
# Without a .env file (or with A2_MODEL unset), the rule-based stand-in runs: no key needed.

# Which live interpreter to use: "claude", "openai", or empty for the rule-based stand-in.
A2_MODEL=

# Anthropic API key (for A2_MODEL=claude), from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key (for A2_MODEL=openai), from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: which OpenAI model to use (check what your account offers; default gpt-5-mini)
A2_OPENAI_MODEL=
