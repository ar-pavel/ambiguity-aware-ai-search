# Copy this file to .env and fill in your own values. .env is ignored by git; never commit a key.
# Without a .env file (or with A2_MODEL unset), the rule-based stand-in runs: no key needed.

# Which live interpreter to use: "claude", "openai", "ollama" (a local model), or empty for the
# rule-based stand-in.
A2_MODEL=

# Anthropic API key (for A2_MODEL=claude), from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key (for A2_MODEL=openai), from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: which OpenAI model to use (check what your account offers; default gpt-5-mini)
A2_OPENAI_MODEL=

# Local model (for A2_MODEL=ollama): no key, and nothing leaves this machine. Install Ollama
# (https://ollama.com, or `brew install ollama`), then `ollama pull qwen3:14b`. Default qwen3:14b.
A2_OLLAMA_MODEL=
# Optional: where Ollama listens (default http://localhost:11434/api/chat)
A2_OLLAMA_URL=

# Local event log for evaluation (logs/events.jsonl, ignored by git). Set to "off" to stop logging.
A2_LOG=
